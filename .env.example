# Copy this file to .env for local testing (never commit the real .env)

# Supabase: Project Settings > Database > Connection string (URI, "Transaction" pooler works too)
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@YOUR_PROJECT.supabase.co:5432/postgres

# Supabase: Project Settings > API
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_KEY=YOUR_SERVICE_ROLE_KEY

PORT=3000

# Shared access code your team enters once to unlock the site (pick anything, tell only your team)
APP_ACCESS_CODE=change-this-code
